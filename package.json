{
  "name": "cortico-world-localvision",
  "version": "0.2.0",
  "type": "module",
  "main": "./src/index.ts",
  "description": "本地视觉 World：本机 OCR（tesseract.js/WASM）把屏幕转成文字+坐标，操作交给 Coopanion 内置电脑操作（pet_cua_*），大幅降低截图 token。",
  "keywords": [
    "cortico-world"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "本地视觉 LocalVision",
    "describe": "describe.json"
  },
  "devDependencies": {
    "cortico": "^0.2.4"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "describe:extension": "node --experimental-transform-types scripts/describe-extension.ts",
    "check:extension": "node --experimental-transform-types scripts/check-extension.ts"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
