{
  "name": "cortico-world-localvision",
  "version": "0.3.0",
  "type": "module",
  "main": "./src/index.ts",
  "description": "在本机把屏幕 OCR 成「文字 + 坐标」，默认不把截图发到云端，省掉每帧看屏的 token；可选接视觉模型，也可硬拦截内置截图。",
  "keywords": [
    "cortico-world"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HY-pt/cortico-world-localvision.git"
  },
  "homepage": "https://github.com/HY-pt/cortico-world-localvision",
  "bugs": {
    "url": "https://github.com/HY-pt/cortico-world-localvision/issues"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "patches",
    "docs",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "os": [
    "win32",
    "darwin"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "本地视觉 LocalVision",
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "tags": [
      "local",
      "experimental",
      "sensitive-data"
    ],
    "locales": {
      "zh": {
        "displayName": "本地视觉 LocalVision",
        "description": "在本机把屏幕 OCR 成「文字 + 坐标」，默认不上传截图，省掉每帧看屏的 token；可选接视觉模型看图，也可硬拦截内置截图。"
      },
      "en": {
        "displayName": "LocalVision",
        "description": "Reads the screen locally with OCR and returns text with coordinates, keeping screenshots off the cloud by default. Optional vision model and built-in screenshot interception."
      }
    }
  },
  "devDependencies": {
    "cortico": "^0.2.4",
    "esbuild": "^0.25.12"
  },
  "scripts": {
    "test": "node --experimental-transform-types scripts/describe-extension.ts && node --experimental-transform-types scripts/check-extension.ts",
    "smoke": "node scripts/smoke.mjs",
    "build:web": "node scripts/build-webui.mjs",
    "describe:extension": "node --experimental-transform-types scripts/describe-extension.ts",
    "check:extension": "node --experimental-transform-types scripts/check-extension.ts",
    "patch:hook": "node scripts/apply-hook-patch.mjs"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
